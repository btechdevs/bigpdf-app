{
  "name": "pdfnest",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-only PDF toolkit — HTML + Tailwind + vanilla JS",
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind.css -o ./css/app.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind.css -o ./css/app.css --watch",
    "check": "python check-css.py && python check-dynamic.py",
    "serve": "python -m http.server 8777"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^3.4.16"
  }
}
